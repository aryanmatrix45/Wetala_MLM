{
  "name": "wetala-mlm-monorepo",
  "version": "1.0.0",
  "description": "Wetala Binary MLM & E-Commerce Management Platform Monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:shared": "npm run build --workspace=@wetala/shared",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=@wetala/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.3.3"
  }
}
